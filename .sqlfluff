# Jinja templater instead of dbt, so linting needs no database connection.
[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 100
# ST06 forces a column order that hurts readability in the marts.
exclude_rules = ST06

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = transform/macros

[sqlfluff:templater:jinja:context]
fx_pair = USD/IDR

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:references.keywords]
# `value` in fct_anomalies is part of the mart contract.
ignore_words = value
