# Copy to .env and fill in. Never commit .env. GitHub Actions uses repository secrets instead.

# Neon Postgres, direct connection (host without "-pooler"):
# postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: the read-only Looker Studio user, only for `python -m jds.check_reader`.
LOOKER_READER_URL=

LOG_LEVEL=INFO
# dlt telemetry is already off in src/jds/__init__.py; set to true to enable it.
RUNTIME__DLTHUB_TELEMETRY=false
