# Salin file ini menjadi .env lalu isi nilainya. .env TIDAK boleh di-commit.
# Di GitHub Actions, nilai yang sama disimpan sebagai Repository Secrets.

# --- Neon Postgres (diisi di Tahap 1) ---
# Format: postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Satu-satunya kredensial database: dipakai check_db, dlt (--dest postgres), dan dbt.
# Pakai koneksi langsung (host TANPA "-pooler").
DATABASE_URL=

# --- Telegram Bot (diisi di Tahap 8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Looker Studio (Tahap 11, opsional, hanya untuk cek lokal) ---
# Koneksi sebagai looker_reader (BUKAN pemilik), dipakai `python -m jds.check_reader`.
# Format sama dengan DATABASE_URL, user looker_reader. Password-nya juga disimpan di Looker Studio.
LOOKER_READER_URL=

# --- Lainnya ---
LOG_LEVEL=INFO
# Telemetri anonim dlt. Sudah MATI secara default lewat src/jds/__init__.py;
# baris ini hanya dokumentasi (isi "true" jika ingin mengaktifkannya).
RUNTIME__DLTHUB_TELEMETRY=false
